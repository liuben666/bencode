/* BenCode TUI 样式 */

Screen {
    background: $surface;
}

/* Provider 选择界面 */
.provider-list {
    width: 60;
    height: auto;
    max-height: 20;
    border: thick $accent;
    padding: 1 2;
}

.provider-list Item {
    padding: 0 1;
}

.provider-list Item.-active {
    text-style: bold;
    background: $accent 20%;
}

/* 对话界面布局 */
#chat-container {
    layout: vertical;
    height: 1fr;
}

/* 消息列表（垂直滚动区） */
.message-list {
    height: 1fr;
    padding: 0 1;
    /* 竖直滚动条样式 */
    scrollbar-size: 1 1;
    scrollbar-color: $accent;
    scrollbar-background: $surface;
    scrollbar-corner-color: $surface;
}

/* 用户消息样式（height: auto 关键：Vertical 默认 1fr 会瓜分视口高度） */
.user-message {
    height: auto;
    background: $primary 15%;
    margin: 1 0;
    padding: 1 2;
    border-left: thick $primary;
}

.user-message .label {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

/* AI 消息样式（同上，必须 height: auto） */
.ai-message {
    height: auto;
    margin: 1 0;
    padding: 1 2;
}

.ai-message .label {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

/* 输入区 */
.input-area {
    height: auto;
    max-height: 14;
    dock: bottom;
    border-top: thick $accent;
    padding: 0 1;
}

#user-input {
    height: 3;
}

/* 输入工具栏 */
#input-toolbar {
    height: auto;
    padding: 0 1;
}

#thinking-btn {
    width: auto;
    background: $accent 20%;
    color: $text;
    text-style: bold;
    border: tall $accent;
}

#thinking-btn.thinking-on {
    background: $accent 40%;
    color: $text;
    text-style: bold;
}

#thinking-btn.thinking-off {
    background: $surface;
    color: $text-muted;
    text-style: none;
}

#send-btn {
    dock: right;
    width: 5;
    min-width: 5;
}

/* 状态栏 */
#status-bar {
    dock: bottom;
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

/* Thinking 折叠区块（Vertical 子类，必须 height: auto） */
.thinking-block {
    height: auto;
    margin: 0 0 1 0;
}

.thinking-block Collapsible {
    border-left: thick $warning;
    padding-left: 1;
}

.thinking-block Collapsible CollapsibleTitle {
    color: $warning;
    text-style: italic;
}

.thinking-block Collapsible .collapsible-content {
    color: $text-muted;
    padding: 0 1;
}

/* 工具调用折叠卡片（必须 height: auto） */
.tool-block {
    height: auto;
    margin: 0 0 1 0;
}

.tool-block Collapsible {
    border-left: thick $accent;
    padding-left: 1;
}

.tool-block Collapsible CollapsibleTitle {
    text-style: bold;
}

.tool-block.tool-running Collapsible {
    border-left: thick $accent;
}

.tool-block.tool-running Collapsible CollapsibleTitle {
    color: $accent;
}

.tool-block.tool-success Collapsible {
    border-left: thick $success;
}

.tool-block.tool-success Collapsible CollapsibleTitle {
    color: $success;
}

.tool-block.tool-error Collapsible,
.tool-block.tool-timeout Collapsible {
    border-left: thick $error;
}

.tool-block.tool-error Collapsible CollapsibleTitle,
.tool-block.tool-timeout Collapsible CollapsibleTitle {
    color: $error;
}

.tool-block.tool-rejected Collapsible {
    border-left: thick $warning;
}

.tool-block.tool-rejected Collapsible CollapsibleTitle {
    color: $warning;
}

.tool-block Collapsible .collapsible-content {
    color: $text-muted;
    padding: 0 1;
}

/* 危险操作确认条（挂在输入框上方，紧凑高度，不遮罩页面） */
.confirm-bar {
    height: 5;
    max-height: 5;
    padding: 0 1;
    background: $warning 12%;
    border-left: thick $warning;
}

.confirm-bar #confirm-info {
    color: $text;
    padding: 0 1;
}

.confirm-bar #confirm-actions {
    height: 3;
    padding: 0 1;
    align: right middle;
}

.confirm-bar #confirm-allow-btn {
    margin-right: 1;
}

/* 错误消息 */
.error-message {
    color: $error;
    padding: 1 2;
    border-left: thick $error;
}

/* 历史会话列表 */
.history-list {
    width: 80;
    height: auto;
    max-height: 25;
    border: thick $accent;
    padding: 1 2;
}

.history-list Item {
    padding: 0 1;
}
